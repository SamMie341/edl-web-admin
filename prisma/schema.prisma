// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  module    String
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum PermissionEffect {
  ALLOW
  DENY
}

model UserPermission {
  userId       Int              @map("user_id")
  permissionId Int              @map("permission_id")
  effect       PermissionEffect @default(ALLOW)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Province {
  id         Int      @id
  name       String
  code       String?
  shortName  String?
  branchCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  disctricts     Disctrict[]
  villages       Village[]
  serviceCenters ServiceCenter[]

  @@map("provinces")
}

model Disctrict {
  id         Int      @id
  provinceId Int
  code       String?
  name       String?
  nameEn     String?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  villages Village[]

  province       Province        @relation(fields: [provinceId], references: [id])
  serviceCenters ServiceCenter[]

  @@map("districts")
}

model Village {
  id         Int      @id
  districtId Int
  code       String?
  name       String?
  nameEn     String?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district Disctrict @relation(fields: [districtId], references: [id])

  provinces      Province[]
  serviceCenters ServiceCenter[]

  @@map("villages")
}

// ==========================================
// MOD-01: Organization Structure & Branches
// ==========================================

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branches       Branch[]
  serviceCenters ServiceCenter[]
  users          User[]

  @@map("departments")
}

model Branch {
  id                   Int          @id @default(autoincrement())
  departmentId         Int          @map("department_id")
  branchName           String       @map("branch_name")
  branchImage          String?      @map("branch_image")
  coverImage           String?      @map("cover_image")
  orgChartImage        String?      @map("org_chart_image")
  address              String?
  locationCoordinates  String?      @map("location_coordinates")
  email                String?
  phoneNumber          String?      @map("phone_number")
  roleResponsibilities String?      @map("role_responsibilities")
  orderIndex           Int          @default(0) @map("order_index")
  status               BranchStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceCenters ServiceCenter[]

  @@map("branches")
}

model ServiceCenter {
  id           Int                 @id @default(autoincrement())
  departmentId Int                 @map("department_id")
  branchId     Int                 @map("branch_id")
  centerName   String              @map("center_name")
  phoneNumber  String?             @map("phone_number")
  provinceId   Int
  districtId   Int
  villageId    Int
  longitude    Decimal?            @db.Decimal(11, 8)
  latitude     Decimal?            @db.Decimal(10, 8)
  imageUrl     String?             @map("image_url")
  status       ServiceCenterStatus @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  province Province  @relation(fields: [provinceId], references: [id])
  district Disctrict @relation(fields: [districtId], references: [id])
  village  Village   @relation(fields: [villageId], references: [id])

  @@map("service_centers")
}

model OrganizationStructure {
  id            Int           @id @default(autoincrement())
  structureType StructureType @map("structure_type")
  structureName String        @map("structure_name")
  imageUrl      String        @default("") @map("image_url")
  chartData     Json?         @map("chart_data")
  orderIndex    Int           @default(0) @map("order_index")
  status        CommonStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("organization_structures")
}

model VisionMission {
  id          Int               @id @default(autoincrement())
  entryType   VisionMissionType @default(VISION) @map("entry_type")
  title       String
  slogan      String?
  description String?
  imageUrl    String?           @map("image_url")
  orderIndex  Int               @default(0) @map("order_index")
  status      CommonStatus      @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("vision_missions")
}

// ==========================================
// MOD-02: News & Media Management
// ==========================================

model ElectricalKnowledge {
  id         Int                       @id @default(autoincrement())
  title      String
  coverImage String?                   @map("cover_image")
  videoUrl   String?                   @map("video_url")
  content    String?
  viewCount  Int                       @default(0) @map("view_count")
  status     ElectricalKnowledgeStatus @default(ACTIVE)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("electrical_knowledge")
}

model Magazine {
  id            Int          @id @default(autoincrement())
  title         String
  issueNumber   String?      @map("issue_number")
  coverImage    String?      @map("cover_image")
  fileUrl       String       @map("file_url")
  publishedDate DateTime?    @map("published_date") @db.Date
  downloadCount Int          @default(0) @map("download_count")
  status        CommonStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@map("magazines")
}

model NewsCategory {
  id           Int          @id @default(autoincrement())
  categoryName String       @map("category_name")
  description  String?
  orderIndex   Int          @default(0) @map("order_index")
  status       CommonStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  news News[]

  @@map("news_categories")
}

model News {
  id            Int        @id @default(autoincrement())
  categoryId    Int        @map("category_id")
  titleLa       String     @map("title_la")
  titleEn       String?    @map("title_en")
  subtitleLa    String?    @map("subtitle_la")
  subtitleEn    String?    @map("subtitle_en")
  coverImage    String?    @map("cover_image")
  galleryImages Json?      @map("gallery_images")
  videoUrl      String?    @map("video_url")
  contentLa     String     @map("content_la")
  contentEn     String?    @map("content_en")
  viewCount     Int        @default(0) @map("view_count")
  publishedAt   DateTime?  @map("published_at") @db.Timestamptz
  status        NewsStatus @default(DRAFT)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  category NewsCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags     NewsTagRelation[]

  @@map("news")
}

model NewsTag {
  id        Int          @id @default(autoincrement())
  tagName   String       @unique @map("tag_name")
  status    CommonStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  news NewsTagRelation[]

  @@map("news_tags")
}

model NewsTagRelation {
  newsId    Int      @map("news_id")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  news News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  NewsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@map("news_tag_relations")
}

// ==========================================
// MOD-03: Public Disclosure & Services
// ==========================================

model Legislation {
  id             Int               @id @default(autoincrement())
  documentNumber String            @map("document_number")
  title          String
  fileUrl        String            @map("file_url")
  issueDate      DateTime          @map("issue_date") @db.Date
  status         LegislationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("legislations")
}

model ElectricityTariff {
  id            Int          @id @default(autoincrement())
  title         String
  tariffType    TariffType   @map("tariff_type")
  imageUrl      String?      @map("image_url")
  pdfUrl        String?      @map("pdf_url")
  effectiveDate DateTime?    @map("effective_date") @db.Date
  status        TariffStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@map("electricity_tariffs")
}

model Procurement {
  id           Int               @id @default(autoincrement())
  tenderNumber String?           @unique @map("tender_number")
  title        String
  fileUrl      String?           @map("file_url")
  imageUrl     String?           @map("image_url")
  startDate    DateTime          @map("start_date") @db.Timestamptz
  endDate      DateTime          @map("end_date") @db.Timestamptz
  description  String?
  status       ProcurementStatus @default(OPEN)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("procurements")
}

model JobPosting {
  id          Int              @id @default(autoincrement())
  positionId  Int              @map("position_id")
  title       String
  subtitle    String?
  imageUrl    String?          @map("image_url")
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime         @map("end_date") @db.Date
  description String
  status      JobPostingStatus @default(OPEN)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@map("job_postings")
}

// ==========================================
// MOD-04: IAM & Personnel Management
// ==========================================

model Position {
  id           Int          @id @default(autoincrement())
  positionName String       @map("position_name")
  description  String?
  status       CommonStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  jobPostings JobPosting[]

  @@map("positions")
}

model User {
  id             Int        @id @default(autoincrement())
  employeeCode   String     @unique @map("employee_code")
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  email          String     @unique
  passwordHash   String     @map("password_hash")
  phoneNumber    String?    @map("phone_number")
  departmentId   Int?       @map("department_id")
  departmentName String?    @map("department_name")
  divisionName   String?    @map("division_name")
  unitName       String?    @map("unit_name")
  roleId         Int?       @map("role_id")
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role            Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userPermissions UserPermission[]

  @@map("users")
}

// ==========================================
// MOD-05: Electricity Calculator & Saving Plan
// ==========================================

enum EffortLevel {
  EASY // ງ່າຍ (ປັບພຶດຕິກຳໄດ້ທັນທີ)
  LOW_COST // ລົງທຶນໜ້ອຍ (ເຊັ່ນ ປ່ຽນດອກໄຟເປັນ LED)
  INVESTMENT // ລົງທຶນ (ເຊັ່ນ ປ່ຽນແອເປັນ Inverter)
}

enum SavingRuleType {
  FIXED_FRACTION // ຫຼຸດຕາມ % ຄົງທີ່ ເຊັ່ນ ຕັ້ງແອ 26°C ຫຼຸດ 15% (0.15)
  REDUCE_HOURS // ຫຼຸດຈຳນວນຊົ່ວໂມງຕໍ່ມື້ ເຊັ່ນ ຕັ້ງເວລາປິດແອໄວຂຶ້ນ 1 ຊມ.
  REPLACE_WATTAGE // ປ່ຽນກຳລັງວັດ ເຊັ່ນ ປ່ຽນດອກໄຟເກົ່າເປັນ LED 9W ຫຼື 16W
}

/// ໝວດໝູ່ເຄື່ອງໃຊ້ໄຟຟ້າ (ເຊັ່ນ ແອ, ຕູ້ເຢັນ, ດອກໄຟ LED, ພັດລົມ, ເຄື່ອງທຳນ້ຳອຸ່ນ)
model ApplianceCategory {
  id         Int          @id @default(autoincrement())
  nameLa     String       @map("name_la")
  nameEn     String?      @map("name_en")
  orderIndex Int          @default(0) @map("order_index")
  status     CommonStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  presets         AppliancePreset[]
  actionTemplates SavingActionTemplate[]

  @@map("appliance_categories")
}

/// ຂໍ້ມູນຕົ້ນແບບເຄື່ອງໃຊ້ໄຟຟ້າ (Preset Dropdown ເຊັ່ນ ແອ 9,000 BTU, ຕູ້ເຢັນ 1–2 ປະຕູ, ພັດລົມ 16 ນິ້ວ)
model AppliancePreset {
  id                  Int          @id @default(autoincrement())
  categoryId          Int          @map("category_id")
  nameLa              String       @map("name_la")
  nameEn              String?      @map("name_en")
  defaultWatt         Int          @map("default_watt")
  defaultQuantity     Int          @default(1) @map("default_quantity")
  defaultHoursPerDay  Decimal      @default(4.0) @map("default_hours_per_day") @db.Decimal(4, 1)
  defaultDaysPerMonth Int          @default(30) @map("default_days_per_month")
  isSampleDefault     Boolean      @default(false) @map("is_sample_default")
  orderIndex          Int          @default(0) @map("order_index")
  status              CommonStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  category ApplianceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("appliance_presets")
}

/// ແມ່ແບບວິທີປະຢັດໄຟແຍກຕາມໝວດໝູ່ເຄື່ອງໃຊ້ໄຟຟ້າ
model SavingActionTemplate {
  id            Int            @id @default(autoincrement())
  categoryId    Int            @map("category_id")
  titleLa       String         @map("title_la")
  titleEn       String?        @map("title_en")
  descriptionLa String         @map("description_la")
  descriptionEn String?        @map("description_en")
  effortLevel   EffortLevel    @default(EASY) @map("effort_level")
  ruleType      SavingRuleType @map("rule_type")

  // ພາລາມິເຕີສຳລັບຄຳນວນສັດສ່ວນການປະຢັດ (frac)
  fixedFraction  Decimal? @map("fixed_fraction") @db.Decimal(5, 4)
  reduceHoursBy  Decimal? @map("reduce_hours_by") @db.Decimal(4, 1)
  targetWattLow  Int?     @map("target_watt_low")
  targetWattHigh Int?     @map("target_watt_high")

  defaultSelected Boolean      @default(true) @map("default_selected")
  orderIndex      Int          @default(0) @map("order_index")
  status          CommonStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  category ApplianceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("saving_action_templates")
}

/// ປະກາດອັດຕາຄ່າໄຟຟ້າ (ເຊັ່ນ ແຈ້ງການ ຟຟລ ເລກທີ 1916/ຟຟລ.ຝທຜ)
model TariffNotice {
  id                      Int          @id @default(autoincrement())
  noticeNumber            String       @unique @map("notice_number")
  title                   String
  issuedDate              DateTime     @map("issued_date") @db.Date
  effectiveFrom           DateTime     @map("effective_from") @db.Date
  effectiveTo             DateTime     @map("effective_to") @db.Date
  vatRate                 Decimal      @default(0.10) @map("vat_rate") @db.Decimal(5, 4)
  hotSeasonDiscountCapKwh Int          @default(300) @map("hot_season_discount_cap_kwh")
  maintenanceFeeKip       Decimal      @default(0) @map("maintenance_fee_kip") @db.Decimal(14, 2)
  status                  CommonStatus @default(ACTIVE)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  schedules TariffSchedule[]

  @@map("tariff_notices")
}

/// ໝວດໝູ່/ປະເພດລາຄາໄຟຟ້າ (Tariff Categories: ທີ່ຢູ່ອາໄສ, ທຸລະກິດ, ອຸດສາຫະກຳ, ກະສິກຳ, ຯລຯ)
model TariffCategory {
  id            Int          @id @default(autoincrement())
  nameLa        String       @map("name_la") // ເຊັ່ນ "ປະເພດທີ່ຢູ່ອາໄສ"
  nameEn        String?      @map("name_en") // ເຊັ່ນ "Residential / Household"
  categoryGroup String?      @map("category_group") // "RESIDENTIAL" | "NON_RESIDENTIAL"
  voltageLevel  String?      @map("voltage_level") // "0.4 kV" | "22 kV" | "115 kV"
  description   String?
  orderIndex    Int          @default(0) @map("order_index")
  status        CommonStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  schedules TariffSchedule[]

  @@map("tariff_categories")
}

/// ຕາຕະລາງອັດຕາຄ່າໄຟລາຍເດືອນ (ພ.ຄ. 2026 - ທ.ຄ. 2029)
model TariffSchedule {
  id                Int      @id @default(autoincrement())
  noticeId          Int      @map("notice_id")
  categoryId        Int      @map("category_id")
  year              Int
  month             Int
  isHotSeason       Boolean  @default(false) @map("is_hot_season")
  maintenanceFeeKip Decimal? @map("maintenance_fee_kip") @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  notice   TariffNotice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  category TariffCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tiers    TariffTier[]

  @@unique([categoryId, year, month])
  @@index([noticeId])
  @@index([categoryId])
  @@index([year, isHotSeason])
  @@map("tariff_schedules")
}

/// ຂັ້ນບັນໄດອັດຕາຄ່າໄຟຟ້າ (8 ຂັ້ນຕໍ່ເດືອນ)
model TariffTier {
  id            Int     @id @default(autoincrement())
  scheduleId    Int     @map("schedule_id")
  tierOrder     Int     @map("tier_order") // 1 - 8
  label         String // "0–25", "26–150", ..., "> 1,500"
  minKwh        Int     @map("min_kwh")
  maxKwh        Int?    @map("max_kwh") // null = ບໍ່ຈຳກັດເພດານ (ຂັ້ນທີ 8)
  rateKipPerKwh Decimal @map("rate_kip_per_kwh") @db.Decimal(10, 2)

  schedule TariffSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, tierOrder])
  @@index([scheduleId])
  @@map("tariff_tiers")
}

// ==========================================
// ENUMS (According to Data Dictionary)
// ==========================================

enum CommonStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum ServiceCenterStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
}

