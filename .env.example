# ==============================================================================
# Database Configuration (PostgreSQL on dedicated DB server)
# Format: postgresql://<user>:<password>@<db-server-ip-or-host>:<port>/<dbname>?schema=public
# ==============================================================================
DATABASE_URL="postgresql://postgres:your_strong_password@192.168.1.100:5432/edl_admin_new_db?schema=public"

# ==============================================================================
# Application Server Configuration
# ==============================================================================
PORT=3005

# Path to persistent uploads folder on host machine (default is ../uploads)
UPLOADS_PATH=../uploads

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://localhost:5173"

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
JWT_SECRET="replace-with-a-very-strong-and-long-random-secret-key"
JWT_EXPIRES_IN="1d"

# ==============================================================================
# HRM Integration Configuration
# ==============================================================================
HRM_API_BASE_URL="https://api-test.edl.com.la/hrm/api"
HRM_USERNAME="your_hrm_username"
HRM_PASSWORD="your_hrm_password"

# ==============================================================================
# Initial SuperAdmin Seed Configuration
# ==============================================================================
SUPERADMIN_PASSWORD="replace-with-strong-superadmin-password-min-12-chars"
# Set to "true" only when intentionally resetting the seeded SuperAdmin password
SUPERADMIN_RESET_PASSWORD="false"
