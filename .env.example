# ==============================================================================
# Database Configuration (PostgreSQL on dedicated DB server)
# Format: postgresql://<user>:<password>@<db-server-ip-or-host>:<port>/<dbname>?schema=public
# ==============================================================================
DATABASE_URL="postgresql://postgres:your_strong_password@192.168.1.100:5432/edl_admin_new_db?schema=public"

# ==============================================================================
# Application Server Configuration
# ==============================================================================
PORT=3000

# Path to persistent uploads folder on host machine (default is ../uploads)
UPLOADS_PATH=../uploads

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
JWT_SECRET="replace-with-a-very-strong-and-long-random-secret-key"
JWT_EXPIRES_IN="1d"
